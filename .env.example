# Banco de dados (desenvolvimento local com SQLite)
DATABASE_URL=sqlite:///./my_profit.db
# Para PostgreSQL: postgresql+psycopg://usuario:senha@localhost:5432/my_profit

# Segurança (troque por uma chave longa e aleatória)
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Endereço do front-end permitido pela API (CORS)
CORS_ORIGINS=http://localhost:5173
